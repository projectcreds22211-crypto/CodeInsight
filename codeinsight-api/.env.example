# ==============================================================================
# CodeInsight API — Environment Configuration Template
# Copy this file to `codeinsight-api/.env` or root `.env` for backend service runs.
# ==============================================================================

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Auth Backend Credentials
CLERK_SECRET_KEY=sk_test_example
CLERK_PUBLISHABLE_KEY=pk_test_example
CLERK_WEBHOOK_SECRET=whsec_example

# Production CORS Origin Matching
FRONTEND_URL=http://localhost:5173

# Port and Host Configuration
PORT=3001
HOST=0.0.0.0

# Optional Claude API Key (Phase 3+)
ANTHROPIC_API_KEY=sk-ant-api03-example
