# ==============================================================================
# CodeInsight — Environment Configuration Template (.env.example)
# Copy this file to `.env` in the repository root for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (codeinsight-web / Vercel)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (required for frontend authentication initialization)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_example

# Backend API Service URL (defaults to http://localhost:3001 in local dev)
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Backend Environment Variables (codeinsight-api / Render)
# ------------------------------------------------------------------------------
# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Backend Secret API Key (JWT verification)
CLERK_SECRET_KEY=sk_test_example

# Clerk Backend Publishable Key
CLERK_PUBLISHABLE_KEY=pk_test_example

# Clerk Webhook Endpoint Signing Secret (/api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=whsec_example

# Frontend Application Origin (for production CORS matching on Render)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Optional AI Service Configuration (Claude / Anthropic — Phase 3+)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-example
